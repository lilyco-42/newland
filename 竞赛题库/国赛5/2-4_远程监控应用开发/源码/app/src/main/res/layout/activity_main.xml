<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Title Bar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:gravity="center"
            android:padding="12dp"
            android:text="远程监控系统"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Status Indicators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_monitor_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableLeft="@android:drawable/ic_lock_idle_lock"
                android:drawablePadding="8dp"
                android:text="@string/monitor_status_off"
                android:textColor="#F44336"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_light_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableLeft="@android:drawable/btn_star"
                android:drawablePadding="8dp"
                android:gravity="end"
                android:text="@string/light_status_off"
                android:textColor="#9E9E9E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Monitor Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@drawable/bg_monitor_off">

            <!-- Camera Preview (SurfaceView for RTSP/USB camera) -->
            <SurfaceView
                android:id="@+id/surface_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:visibility="gone" />

            <!-- Background image when monitor is off -->
            <LinearLayout
                android:id="@+id/layout_monitor_off"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="#55FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/monitor_area_label"
                    android:textColor="#88FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="点击下方按钮开启监控"
                    android:textColor="#55FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Start/Stop Monitor Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start_monitor"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/btn_start_monitor"
                android:text="@string/btn_start_monitor"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="visible" />

            <Button
                android:id="@+id/btn_stop_monitor"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/btn_stop_monitor"
                android:text="@string/btn_stop_monitor"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Manual Light Control (shown when monitor is OFF) -->
        <LinearLayout
            android:id="@+id/layout_manual_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auto_settings"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/light_control_label"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <!-- Light Bulb Indicator -->
            <ImageView
                android:id="@+id/iv_light_indicator"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_light_bulb_off" />

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_light_on"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_light_on"
                    android:text="@string/btn_light_on"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_light_off"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_light_off"
                    android:text="@string/btn_light_off"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Camera Direction Control (shown when monitor is ON) -->
        <LinearLayout
            android:id="@+id/layout_camera_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_control_label"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <!-- Direction Pad -->
            <RelativeLayout
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center">

                <!-- Up Button -->
                <Button
                    android:id="@+id/btn_up"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/btn_direction"
                    android:text="▲"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <!-- Down Button -->
                <Button
                    android:id="@+id/btn_down"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/btn_direction"
                    android:text="▼"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <!-- Left Button -->
                <Button
                    android:id="@+id/btn_left"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:background="@drawable/btn_direction"
                    android:text="◀"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <!-- Right Button -->
                <Button
                    android:id="@+id/btn_right"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"
                    android:background="@drawable/btn_direction"
                    android:text="▶"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <!-- Center label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="PTZ"
                    android:textColor="#999999"
                    android:textSize="12sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Auto Settings Area (shown when monitor is ON) -->
        <LinearLayout
            android:id="@+id/layout_auto_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auto_settings"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_settings_label"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <!-- Auto Light On Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auto_light_on_time"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_auto_on_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_time_picker"
                    android:padding="6dp"
                    android:text="18:00"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <!-- Auto Light Off Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auto_light_off_time"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_auto_off_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_time_picker"
                    android:padding="6dp"
                    android:text="06:00"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <!-- Camera RTSP Address -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_rtsp"
                android:textColor="#555555"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_rtsp"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_time_picker"
                android:hint="@string/hint_rtsp"
                android:inputType="textUri"
                android:maxLines="1"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <!-- PTZ Control Address -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_ptz"
                android:textColor="#555555"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_ptz"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_time_picker"
                android:hint="@string/hint_ptz"
                android:inputType="textUri"
                android:maxLines="2"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_save_settings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/btn_settings"
                android:text="@string/btn_save_settings"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
