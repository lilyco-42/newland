<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F5E9">

    <!-- ============ 图2 主界面（在登录遮罩之下） ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="温室培育甲烷气体监测系统"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <!-- 甲烷实时值 -->
        <TextView
            android:id="@+id/tv_methane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="甲烷: -- %"
            android:textSize="36sp"
            android:textColor="#2E7D32"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tv_threshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="甲烷报警阈值: 25.0 %"
            android:textSize="14sp"
            android:textColor="#666" />

        <!-- 风扇图片（超标时旋转） -->
        <ImageView
            android:id="@+id/iv_fan"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_fan"
            android:contentDescription="风扇" />

        <TextView
            android:id="@+id/tv_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="当前模式: 自动"
            android:padding="6dp" />

        <!-- 模式与手动控制按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="切换到手动" />

            <Button
                android:id="@+id/btn_fan_on"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="风扇开" />

            <Button
                android:id="@+id/btn_fan_off"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="风扇关" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#C62828"
            android:text="注销退出云服务"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- ============ 图1 登录页（模态遮罩，覆盖主界面） ============ -->
    <LinearLayout
        android:id="@+id/login_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0F0F0"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 右上角设置按钮（点击 -> 图3 设置页） -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:padding="8dp"
                android:text="设置"
                android:textSize="16sp"
                android:textColor="#1565C0"
                android:id="@+id/btn_open_settings" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="温室培育甲烷监测"
            android:textSize="22sp"
            android:textStyle="bold"
            android:padding="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用户名：" />

        <EditText
            android:id="@+id/et_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="云服务系统用户名"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="密  码："
            android:paddingTop="8dp" />

        <EditText
            android:id="@+id/et_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="云服务系统密码"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#2E7D32"
            android:text="登录到云服务系统"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>
