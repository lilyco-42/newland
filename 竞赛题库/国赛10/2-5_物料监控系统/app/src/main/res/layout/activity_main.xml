<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="物料监控系统"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tvAlarmStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tvalarmstatus: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvMaxThreshold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tvmaxthreshold: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvMicroSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tvmicroswitch: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvMinThreshold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tvminthreshold: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvPushrodStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tvpushrodstatus: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tvspeed: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSpeedStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tvspeedstatus: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStirrerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tvstirrerstatus: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tvwarning: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/imgStirrer"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Btnstart"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Btnstop"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/viewAlarmLED"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viewalarmled"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/viewGreenLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viewgreenlight"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/viewMicroSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viewmicroswitch"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/viewRedLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viewredlight"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/viewYellowLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viewyellowlight"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>