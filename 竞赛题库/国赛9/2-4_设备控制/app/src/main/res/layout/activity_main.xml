<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备控制"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tv_blue_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blue Value: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_buzzer_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buzzer Status: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_device_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Status: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_green_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Green Value: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_red_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Red Value: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_buzzer_off"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Buzzer Off"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btn_buzzer_on"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Buzzer On"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_led_off"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Led Off"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btn_led_on"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Led On"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_refresh"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Refresh"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/seekbar_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seekbar Blue"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/seekbar_green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seekbar Green"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/seekbar_red"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seekbar Red"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>