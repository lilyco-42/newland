<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="停车场管理"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tv_available_slots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Slots: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_entry_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entry Status: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_exit_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exit Status: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_gate_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gate Status: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_vehicle_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle Count: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_entry_open"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Entry Open"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btn_exit_open"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Exit Open"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_gate_close"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Gate Close"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btn_gate_open"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Gate Open"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_refresh"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Refresh"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>