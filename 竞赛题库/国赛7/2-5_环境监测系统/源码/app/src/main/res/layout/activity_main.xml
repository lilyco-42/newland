<?xml version="1.0" encoding="utf-8"?>
<!--
  2-5 环境监测主界面 - 对照赛题参考图 image11
  全屏餐厅背景 + 顶部橙色通栏"参观导览客户端" + 右上角蓝色"环境监测"面板
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 全屏餐厅背景图 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_restaurant"
        android:contentDescription="餐厅背景" />

    <!-- 顶部橙色通栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF9800"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="参观导览客户端"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 连接/断开/帮助 小按钮放顶栏右侧 -->
        <Button
            android:id="@+id/btn_connect"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="连接"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="#e65100"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="断开"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="#e65100"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_help"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="?"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="#e65100"
            android:minWidth="0dp"
            android:padding="0dp" />
    </LinearLayout>

    <!-- 右上角"环境监测"浮层面板 -->
    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="12dp"
        android:background="#F0F0F0"
        android:padding="6dp"
        android:elevation="6dp">

        <!-- 蓝色标题栏 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1976D2"
            android:padding="6dp"
            android:gravity="center"
            android:text="环境监测"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 温度行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="6dp"
            android:layout_marginTop="4dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_temp_new"
                android:layout_marginEnd="6dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="温度"
                android:textColor="#333333"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_temper_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FF5722"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 湿度行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="6dp"
            android:layout_marginTop="4dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_hum_new"
                android:layout_marginEnd="6dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="湿度"
                android:textColor="#333333"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_humidity_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CO2 行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="6dp"
            android:layout_marginTop="4dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_body_new"
                android:layout_marginEnd="6dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CO2"
                android:textColor="#333333"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_co2_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FF9800"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 光照行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="6dp"
            android:layout_marginTop="4dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_light_new"
                android:layout_marginEnd="6dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="光照"
                android:textColor="#333333"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_light_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#2196F3"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 左下角: 连接状态 + 服务器配置(半透明浮层) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="vertical"
        android:background="#80000000"
        android:padding="8dp"
        android:layout_margin="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tv_conn_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未连接"
                android:textColor="#FFCDD2"
                android:textSize="11sp"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="演示模式"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <EditText
                android:id="@+id/et_host"
                android:layout_width="110dp"
                android:layout_height="32dp"
                android:hint="服务器IP"
                android:text="192.168.1.1"
                android:textColor="#FFFFFF"
                android:textColorHint="#BBBBBB"
                android:textSize="11sp"
                android:singleLine="true"
                android:background="#40000000"
                android:padding="6dp"
                android:layout_marginEnd="4dp" />
            <EditText
                android:id="@+id/et_port"
                android:layout_width="70dp"
                android:layout_height="32dp"
                android:hint="端口"
                android:text="8080"
                android:textColor="#FFFFFF"
                android:textColorHint="#BBBBBB"
                android:textSize="11sp"
                android:singleLine="true"
                android:inputType="number"
                android:background="#40000000"
                android:padding="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部时间戳 -->
    <TextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:background="#80000000"
        android:padding="4dp"
        android:layout_margin="10dp"
        android:text="--" />

</FrameLayout>
